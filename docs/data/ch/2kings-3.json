,"w":[{"en":"","sm":"Ua"},{"en":"","sm":"alu"},{"en":"","sm":"foi"},{"en":"","sm":"lana"},{"en":"","sm":"feau"},{"en":"","sm":"ia"},{"en":"","sm":"Iosefatu"},{"en":"","sm":"le"},{"en":"","sm":"tupu"},{"en":"","sm":"o"},{"en":"","sm":"Iuta,"},{"en":"","sm":"ua"},{"en":"","sm":"faapea"},{"en":"","sm":"atu,"},{"en":"","sm":"Ua"},{"en":"","sm":"foua"},{"en":"","sm":"a‘u"},{"en":"","sm":"eletupuo"},{"en":"","sm":"Moapi,"},{"en":"","sm":"petateo"},{"en":"","sm":"ea"},{"en":"","sm":"ma"},{"en":"","sm":"aʻu"},{"en":"","sm":"e"},{"en":"","sm":"tau"},{"en":"","sm":"ma"},{"en":"","sm":"Moapi?"},{"en":"","sm":"Ona"},{"en":"","sm":"fai"},{"en":"","sm":"mai"},{"en":"","sm":"lea"},{"en":"","sm":"o"},{"en":"","sm":"ia,"},{"en":"","sm":"Ta"},{"en":"","sm":"te"},{"en":"","sm":"o"},{"en":"","sm":"ae"},{"en":"","sm":"lava,"},{"en":"","sm":"o"},{"en":"","sm":"au"},{"en":"","sm":"e"},{"en":"","sm":"pei"},{"en":"","sm":"o"},{"en":"","sm":"oe,"},{"en":"","sm":"o"},{"en":"","sm":"loʻu"},{"en":"","sm":"nuu"},{"en":"","sm":"e"},{"en":"","sm":"pei"},{"en":"","sm":"o"},{"en":"","sm":"lou"},{"en":"","sm":"nuu,"},{"en":"","sm":"o"},{"en":"","sm":"aʻu"},{"en":"","sm":"solofanua"},{"en":"","sm":"e"},{"en":"","sm":"pei"},{"en":"","sm":"o"},{"en":"","sm":"au"},{"en":"","sm":"solofanua."}]},{"en":"And he said, Which way shall we go up? And he answered, The way through the wilderness of Edom.","n":8,"sm":"Ona fai atu lea o ia, O le fea ala tatou te O ae ai? Ona tali mai lea o ia, o le ala e ui i le vao o Etoma.","w":[{"en":"","sm":"Ona"},{"en":"","sm":"fai"},{"en":"","sm":"atu"},{"en":"","sm":"lea"},{"en":"","sm":"o"},{"en":"","sm":"ia,"},{"en":"","sm":"O"},{"en":"","sm":"le"},{"en":"","sm":"fea"},{"en":"","sm":"ala"},{"en":"","sm":"tatou"},{"en":"","sm":"te"},{"en":"","sm":"O"},{"en":"","sm":"ae"},{"en":"","sm":"ai?"},{"en":"","sm":"Ona"},{"en":"","sm":"tali"},{"en":"","sm":"mai"},{"en":"","sm":"lea"},{"en":"","sm":"o"},{"en":"","sm":"ia,"},{"en":"","sm":"o"},{"en":"","sm":"le"},{"en":"","sm":"ala"},{"en":"","sm":"e"},{"en":"","sm":"ui"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"vao"},{"en":"","sm":"o"},{"en":"","sm":"Etoma."}]},{"en":"So the king of Israel went, and the king of Judah, and the king of Edom: and they fetched a compass of seven days' journey: and there was no water for the host, and for the cattle that followed them.","n":9,"sm":"Ona latou o ai lea, o le tupu o Isaraelu, ma le tupu o Iuta, atoa ma le tupu o Etoma. Ua po fitu o latou o faataamilo ai i le ala; ona leai lea o se vai e inu ai “au, atoa ma manu ua ia te i latou.","w":[{"en":"","sm":"Ona"},{"en":"","sm":"latou"},{"en":"","sm":"o"},{"en":"","sm":"ai"},{"en":"","sm":"lea,"},{"en":"","sm":"o"},{"en":"","sm":"le"},{"en":"","sm":"tupu"},{"en":"","sm":"o"},{"en":"","sm":"Isaraelu,"},{"en":"","sm":"ma"},{"en":"","sm":"le"},{"en":"","sm":"tupu"},{"en":"","sm":"o"},{"en":"","sm":"Iuta,"},{"en":"","sm":"atoa"},{"en":"","sm":"ma"},{"en":"","sm":"le"},{"en":"","sm":"tupu"},{"en":"","sm":"o"},{"en":"","sm":"Etoma."},{"en":"","sm":"Ua"},{"en":"","sm":"po"},{"en":"","sm":"fitu"},{"en":"","sm":"o"},{"en":"","sm":"latou"},{"en":"","sm":"o"},{"en":"","sm":"faataamilo"},{"en":"","sm":"ai"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"ala;"},{"en":"","sm":"ona"},{"en":"","sm":"leai"},{"en":"","sm":"lea"},{"en":"","sm":"o"},{"en":"","sm":"se"},{"en":"","sm":"vai"},{"en":"","sm":"e"},{"en":"","sm":"inu"},{"en":"","sm":"ai"},{"en":"","sm":"“au,"},{"en":"","sm":"atoa"},{"en":"","sm":"ma"},{"en":"","sm":"manu"},{"en":"","sm":"ua"},{"en":"","sm":"ia"},{"en":"","sm":"te"},{"en":"","sm":"i"},{"en":"","sm":"latou."}]},{"en":"And the king of Israel said, Alas! that the LORD hath called these three kings together, to deliver them into the hand of Moab!","n":10,"sm":"Ona fai atu lea o le tupu o Isaraelu, Oi talofa! ua faapotopoto e le ALII nei tupu e toatolu e tuuina atu i latou i lima o Moapi.","w":[{"en":"","sm":"Ona"},{"en":"","sm":"fai"},{"en":"","sm":"atu"},{"en":"","sm":"lea"},{"en":"","sm":