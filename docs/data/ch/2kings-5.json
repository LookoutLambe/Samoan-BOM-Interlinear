:"Ua"},{"en":"","sm":"faitau"},{"en":"","sm":"e"},{"en":"","sm":"le"},{"en":"","sm":"tupu"},{"en":"","sm":"o"},{"en":"","sm":"Isaraelu"},{"en":"","sm":"le"},{"en":"","sm":"tusi,"},{"en":"","sm":"ona"},{"en":"","sm":"saei"},{"en":"","sm":"lea"},{"en":"","sm":"e"},{"en":"","sm":"ja"},{"en":"","sm":"ona"},{"en":"","sm":"ofu,"},{"en":"","sm":"ua"},{"en":"","sm":"faapea"},{"en":"","sm":"ane,"},{"en":"","sm":"O"},{"en":"","sm":"au"},{"en":"","sm":"ea"},{"en":"","sm":"o"},{"en":"","sm":"le"},{"en":"","sm":"Atua"},{"en":"","sm":"e"},{"en":"","sm":"fasi"},{"en":"","sm":"oti"},{"en":"","sm":"ma"},{"en":"","sm":"faaola,"},{"en":"","sm":"ua"},{"en":"","sm":"awna"},{"en":"","sm":"mai"},{"en":"","sm":"ai"},{"en":"","sm":"e"},{"en":"","sm":"lena"},{"en":"","sm":"tagata"},{"en":"","sm":"ia"},{"en":"","sm":"te"},{"en":"","sm":"au"},{"en":"","sm":"e"},{"en":"","sm":"faatea"},{"en":"","sm":"se"},{"en":"","sm":"tagata"},{"en":"","sm":"i"},{"en":"","sm":"lona"},{"en":"","sm":"lepela?"},{"en":"","sm":"Ina"},{"en":"","sm":"manatunatu"},{"en":"","sm":"ia,"},{"en":"","sm":"ma"},{"en":"","sm":"ia"},{"en":"","sm":"outou"},{"en":"","sm":"iloa,"},{"en":"","sm":"ua"},{"en":"","sm":"saili"},{"en":"","sm":"e"},{"en":"","sm":"ia"},{"en":"","sm":"se"},{"en":"","sm":"mea"},{"en":"","sm":"e"},{"en":"","sm":"faaalani"},{"en":"","sm":"ai"},{"en":"","sm":"se"},{"en":"","sm":"taua"},{"en":"","sm":"la"},{"en":"","sm":"te"},{"en":"","sm":"au."}]},{"en":"And it was so, when Elisha the man of God had heard that the king of Israel had rent his clothes, that he sent to the king, saying, Wherefore hast thou rent thy clothes? let him come now to me, and he shall know that there is a prophet in Israel.","n":8,"sm":"A ua logona e Elisaia le tagata o le Atua ua saei e le tupu o Isaraelu ona ofu, ona ave lea o le feau ia te ia, ua faapea atu, Se a ea le mea ua e saei ai ou ofu? la sau lava ia ia te au, ona iloa ai lea e ia o loo ia Isaraelu le perofeta.","w":[{"en":"","sm":"A"},{"en":"","sm":"ua"},{"en":"","sm":"logo