{"book":"proverbs","num":8,"verses":[{"en":"Doth not wisdom cry? and understanding put forth her voice?","n":1,"sm":"O le silisili o le aoga o le poto E le ua valaau ea le poto, ma leo tele mai le faautauta?","w":[{"en":"","sm":"O"},{"en":"","sm":"le"},{"en":"","sm":"silisili"},{"en":"","sm":"o"},{"en":"","sm":"le"},{"en":"","sm":"aoga"},{"en":"","sm":"o"},{"en":"","sm":"le"},{"en":"","sm":"poto"},{"en":"","sm":"E"},{"en":"","sm":"le"},{"en":"","sm":"ua"},{"en":"","sm":"valaau"},{"en":"","sm":"ea"},{"en":"","sm":"le"},{"en":"","sm":"poto,"},{"en":"","sm":"ma"},{"en":"","sm":"leo"},{"en":"","sm":"tele"},{"en":"","sm":"mai"},{"en":"","sm":"le"},{"en":"","sm":"faautauta?"}]},{"en":"She standeth in the top of high places, by the way in the places of the paths.","n":2,"sm":"O loo tuo ia i le tumutumu o mea maualuga i tafatafa ane o le ala, i le fetaulaigáala;","w":[{"en":"","sm":"O"},{"en":"","sm":"loo"},{"en":"","sm":"tuo"},{"en":"","sm":"ia"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"tumutumu"},{"en":"","sm":"o"},{"en":"","sm":"mea"},{"en":"","sm":"maualuga"},{"en":"","sm":"i"},{"en":"","sm":"tafatafa"},{"en":"","sm":"ane"},{"en":"","sm":"o"},{"en":"","sm":"le"},{"en":"","sm":"ala,"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"fetaulaigáala;"}]},{"en":"She crieth at the gates, at the entry of the city, at the coming in at the doors.","n":3,"sm":"ua alaga o ia i le itu o le puipui, i le ala o le aai, i le mea e ui atuai ile faitotoa.","w":[{"en":"","sm":"ua"},{"en":"","sm":"alaga"},{"en":"","sm":"o"},{"en":"","sm":"ia"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"itu"},{"en":"","sm":"o"},{"en":"","sm":"le"},{"en":"","sm":"puipui,"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"ala"},{"en":"","sm":"o"},{"en":"","sm":"le"},{"en":"","sm":"aai,"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"mea"},{"en":"","sm":"e"},{"en":"","sm":"ui"},{"en":"","sm":"atuai"},{"en":"","sm":"ile"},{"en":"","sm":"faitotoa."}]},{"en":"Unto you, O men, I call; and my voice is to the sons of man.","n":4,"sm":"Ou te valaau ia te outou tagata; ma ou leo tele atu i le fanau a tagata.","w":[{"en":"","sm":"Ou"},{"en":"","sm":"te"},{"en":"","sm":"valaau"},{"en":"","sm":"ia"},{"en":"","sm":"te"},{"en":"","sm":"outou"},{"en":"","sm":"tagata;"},{"en":"","sm":"ma"},{"en":"","sm":"ou"},{"en":"","sm":"leo"},{"en":"","sm":"tele"},{"en":"","sm":"atu"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"fanau"},{"en":"","sm":"a"},{"en":"","sm":"tagata."}]},{"en":"O ye simple, understand wisdom: and, ye fools, be ye of an understanding heart.","n":5,"sm":"Outou E faigofie e, ia outou noa le faautauta; ma owon ē valelea, ia loto matala outou.","w":[{"en":"","sm":"Outou"},{"en":"","sm":"E"},{"en":"","sm":"faigofie"},{"en":"","sm":"e,"},{"en":"","sm":"ia"},{"en":"","sm":"outou"},{"en":"","sm":"noa"},{"en":"","sm":"le"},{"en":"","sm":"faautauta;"},{"en":"","sm":"ma"},{"en":"","sm":"owon"},{"en":"","sm":"ē"},{"en":"","sm":"valelea,"},{"en":"","sm":"ia"},{"en":"","sm":"loto"},{"en":"","sm":"matala"},{"en":"","sm":"outou."}]},{"en":"Hear; for I will speak of excellent things; and the opening of my lips shall be right things.","n":6,"sm":"la outou faalogologo mai, auā ou te tautalatala i mea sili; e tautala oʻu laugutu i mea tonu.","w":[{"en":"","sm":"la"},{"en":"","sm":"outou"},{"en":"","sm":"faalogologo"},{"en":"","sm":"mai,"},{"en":"","sm":"auā"},{"en":"","sm":"ou"},{"en":"","sm":"te"},{"en":"","sm":"tautalatala"},{"en":"","sm":"i"},{"en":"","sm":"mea"},{"en":"","sm":"sili;"},{"en":"","sm":"e"},{"en":"","sm":"tautala"},{"en":"","sm":"oʻu"},{"en":"","sm":"laugutu"},{"en":"","sm":"i"},{"en":"","sm":"mea"},{"en":"","sm":"tonu."}]},{"en":"For my mouth shall speak truth; and wickedness is an abomination to my lips.","n":7,"sm":"Auā e tautala loʻu gutu ma le faamaoni; a o le amio leaga, e inosia lea i oʻu laugutu.","w":[{"en":"","sm":"Auā"},{"en":"","sm":"e"},{"en":"","sm":"tautala"},{"en":"","sm":"loʻu"},{"en":"","sm":"gutu"},{"en":"