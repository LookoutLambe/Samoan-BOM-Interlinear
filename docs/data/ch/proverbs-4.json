sm":"te"},{"en":"","sm":"oe."}]},{"en":"Let thine eyes look right on, and let thine eyelids look straight before thee.","n":25,"sm":"Ia vaai saʻo ou mata i ou luma; ma ou laumata, ia faasagatonu ia i ou luma.","w":[{"en":"","sm":"Ia"},{"en":"","sm":"vaai"},{"en":"","sm":"saʻo"},{"en":"","sm":"ou"},{"en":"","sm":"mata"},{"en":"","sm":"i"},{"en":"","sm":"ou"},{"en":"","sm":"luma;"},{"en":"","sm":"ma"},{"en":"","sm":"ou"},{"en":"","sm":"laumata,"},{"en":"","sm":"ia"},{"en":"","sm":"faasagatonu"},{"en":"","sm":"ia"},{"en":"","sm":"i"},{"en":"","sm":"ou"},{"en":"","sm":"luma."}]},{"en":"Ponder the path of thy feet, and let all thy ways be established.","n":26,"sm":"la mafaufau i le ala o ou yae; ona faatumauina ai lea o ou ala uma.","w":[{"en":"","sm":"la"},{"en":"","sm":"mafaufau"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"ala"},{"en":"","sm":"o"},{"en":"","sm":"ou"},{"en":"","sm":"yae;"},{"en":"","sm":"ona"},{"en":"","sm":"faatumauina"},{"en":"","sm":"ai"},{"en":"","sm":"lea"},{"en":"","sm":"o"},{"en":"","sm":"ou"},{"en":"","sm":"ala"},{"en":"","sm":"uma."}]},{"en":"Turn not to the right hand nor to the left: remove thy foot from evil.","n":27,"sm":"Aua neʻi afe i le itu taumatau po o le itu tauagavale; ia “alo ese ou vae ile leaga.","w":[{"en":"","sm":"Aua"},{"en":"","sm":"neʻi"},{"en":"","sm":"afe"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"itu"},{"en":"","sm":"taumatau"},{"en":"","sm":"po"},{"en":"","sm":"o"},{"en":"","sm":"le"},{"en":"","sm":"itu"},{"en":"","sm":"tauagavale;"},{"en":"","sm":"ia"},{"en":"","sm":"“alo"},{"en":"","sm":"ese"},{"en":"","sm":"ou"},{"en":"","sm":"vae"},{"en":"","sm":"ile"},{"en":"","sm":"leaga."}]}]}