{"book":"jeremiah","num":13,"verses":[{"en":"Thus saith the LORD unto me, Go and get thee a linen girdle, and put it upon thy loins, and put it not in water.","n":1,"sm":"O faatusa i le fusi lino ma fagu uaina Ua faapea ona fetalai mai o le ALII ia te au, Alu ia, ia e fai mo oe le fusi lino, ma fusi aʻi lou sulugatiti, aua foi e te tuu i le vai.","w":[{"en":"","sm":"O"},{"en":"","sm":"faatusa"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"fusi"},{"en":"","sm":"lino"},{"en":"","sm":"ma"},{"en":"","sm":"fagu"},{"en":"","sm":"uaina"},{"en":"","sm":"Ua"},{"en":"","sm":"faapea"},{"en":"","sm":"ona"},{"en":"","sm":"fetalai"},{"en":"","sm":"mai"},{"en":"","sm":"o"},{"en":"","sm":"le"},{"en":"","sm":"ALII"},{"en":"","sm":"ia"},{"en":"","sm":"te"},{"en":"","sm":"au,"},{"en":"","sm":"Alu"},{"en":"","sm":"ia,"},{"en":"","sm":"ia"},{"en":"","sm":"e"},{"en":"","sm":"fai"},{"en":"","sm":"mo"},{"en":"","sm":"oe"},{"en":"","sm":"le"},{"en":"","sm":"fusi"},{"en":"","sm":"lino,"},{"en":"","sm":"ma"},{"en":"","sm":"fusi"},{"en":"","sm":"aʻi"},{"en":"","sm":"lou"},{"en":"","sm":"sulugatiti,"},{"en":"","sm":"aua"},{"en":"","sm":"foi"},{"en":"","sm":"e"},{"en":"","sm":"te"},{"en":"","sm":"tuu"},{"en":"","sm":"i"},{"en":"","sm":"le"},{"en":"","sm":"vai."}]},{"en":"So I got a girdle according to the word of the LORD, and put it on my loins.","n":2,"sm":"Ona ou maua lea o le fusi e tu3a ma le afioga a le ALII, ma ou fusi ai loʻu sulugatiti.","w":[{"en":"","sm":"Ona"},{"en":"","sm":"ou"},{"en":"","sm":"maua"},{"en":"","sm":"lea"},{"en":"","sm":"o"},{"en":"","sm":"le"},{"en":"","sm":"fusi"},{"en":"","sm":"e"},{"en":"","sm":"tu3a"},{"en":"","sm":"ma"},{"en":"","sm":"le"},{"en":"","sm":"afioga"},{"en":"","sm":"a"},{"en":"","sm":"le"},{"en":"","sm":"ALII,"},{"en":"","sm":"ma"},{"en":"","sm":"ou"},{"en":"","sm":"fusi"},{"en":"","sm":"ai"},{"en":"","sm":"loʻu"},{"en":"","sm":"sulugatiti."}]},{"en":"And the word of the LORD came unto me the second time, saying,","n":3,"sm":"Ona foi faalua 